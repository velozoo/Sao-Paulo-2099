  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d62615745f9a7fa479653f7538a99845, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TypewriterEffect
  testText: "A Frente da Ordem Perfeita divulga um v\xEDdeo no qual seu candidato
    afirma que \u201Ca seguran\xE7a come\xE7a quando sabemos exatamente quem est\xE1
    do nosso lado\u201D.  A Liga da Liberdade Instant\xE2nea acusa o governo de criar
    cidad\xE3os de primeira e segunda classe. Entretanto, a candidata evita responder
    se revogar\xE1 as medidas caso seja eleita.  O Metr\xF4 anuncia o Decreto de
    Integridade C\xEDvica: todos os passageiros suspeitos dever\xE3o ter seus documentos
    conferidos no sistema de identifica\xE7\xE3o e cruzados com o cadastro oficial
    de filia\xE7\xE3o ao Sol Vermelho."
  characterPerSecond: 20
  interpunctuationDelay: 0.5
  finalSetenceDelay: 5
