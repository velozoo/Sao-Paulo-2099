  m_Script: {fileID: 11500000, guid: 67b86d91ff5b11341b785e89d40d1e35, type: 3}
  m_Name: Diary_Day5-2
  m_EditorClassIdentifier: Assembly-CSharp::DiaryData
  dayTitle: 
  pageContent: "Uma cuidadora de sessenta e um anos criticara a repress\xE3o numa
    publica\xE7\xE3o, e havia gente que dependia dela. Eu tamb\xE9m dependo de algo
    e n\xE3o digo a ningu\xE9m.\r\n\r\nHoje as tr\xEAs verifica\xE7\xF5es se completaram,
    e o chefe comentou que eu estava r\xE1pido. Tomei como elogio. Foi a primeira
    vez em dias que me perguntei se rapidez era o que eu queria ser."
