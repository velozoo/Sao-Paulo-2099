  m_Script: {fileID: 11500000, guid: 67b86d91ff5b11341b785e89d40d1e35, type: 3}
  m_Name: Diary_Day4
  m_EditorClassIdentifier: Assembly-CSharp::DiaryData
  dayTitle: Dia 22 de setembro de 2089
  pageContent: "Agora leio o que as pessoas escrevem. Entro nas p\xE1ginas delas
    como quem entra num quarto alheio, s\xF3 que com permiss\xE3o e sem constrangimento,
    o que \xE9 pior.\r\n\r\nA jornalista tinha dezoito anos, e dezoito anos \xE9
    pouco para tanta coragem. Publicara uma frase, uma s\xF3, dizendo que o Sol Vermelho
    n\xE3o desapareceria porque algu\xE9m mandava. Pensei que ela ainda n\xE3o aprendeu
    o pre\xE7o das frases, e que eu estava ali justamente para cobr\xE1-lo, ou para
    n\xE3o cobrar, o que daria no mesmo para o meu sono."
