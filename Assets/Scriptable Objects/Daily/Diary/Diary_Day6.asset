  m_Script: {fileID: 11500000, guid: 67b86d91ff5b11341b785e89d40d1e35, type: 3}
  m_Name: Diary_Day6
  m_EditorClassIdentifier: Assembly-CSharp::DiaryData
  dayTitle: Dia 24 de setembro de 2089
  pageContent: "Chegou a obrigatoriedade do Passa F\xE1cil. Agora n\xE3o basta ser
    quem se diz ser, \xE9 preciso ter pago para ser. Descobri que a ordem moral do
    mundo cabe numa mensalidade.\r\n\r\nDe manh\xE3, um homem de terno veio \xE0
    cabine, bem apresentado, bem tratado, e me disse que o pr\xF3ximo passageiro
    era um infiltrado e que eu sabia o que fazer. Desejou-me boa sorte. Ningu\xE9m
    me desejara boa sorte em meses, e aquilo soou menos como um desejo do que como
    uma amea\xE7a educada."
