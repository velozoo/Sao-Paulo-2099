  m_Script: {fileID: 11500000, guid: 67b86d91ff5b11341b785e89d40d1e35, type: 3}
  m_Name: Diary_Day3
  m_EditorClassIdentifier: Assembly-CSharp::DiaryData
  dayTitle: Dia 21 de setembro de 2089
  pageContent: "O procedimento j\xE1 se faz sozinho. Abro, leio, decido, fecho. Percebi
    hoje que tenho um ritmo, e achei isso pior do que qualquer outra coisa que poderia
    ter percebido.\r\n\r\nUma atendente de farm\xE1cia usava um bottonzinho do Sol
    Vermelho no canto da camiseta e dizia que o achava bonito, que era est\xE9tica.
    N\xE3o duvido. Pensei que talvez a est\xE9tica seja justamente a maneira como
    as coisas come\xE7am a significar algo."
