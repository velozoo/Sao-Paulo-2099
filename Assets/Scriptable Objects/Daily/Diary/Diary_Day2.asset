  m_Script: {fileID: 11500000, guid: 67b86d91ff5b11341b785e89d40d1e35, type: 3}
  m_Name: Diary_Day2
  m_EditorClassIdentifier: Assembly-CSharp::DiaryData
  dayTitle: Dia 20 de Setembro de 2089
  pageContent: "Hoje passei a conferir documentos. Agora h\xE1 um sistema que me
    diz quem pertence a qu\xEA, e eu apenas leio. Ler \xE9 mais f\xE1cil do que julgar,
    e talvez seja por isso que me deram a leitura.\r\n\r\nUma estudante de vinte
    e oito anos tinha prova. A camiseta era comum, mas o cadastro dizia o resto.
    Se for verdade que ela apenas se registrou numa lista, a lista n\xE3o pergunta
    se \xE9 verdade. E eu n\xE3o pergunto \xE0 lista."
