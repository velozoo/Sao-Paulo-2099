  m_Script: {fileID: 11500000, guid: 67b86d91ff5b11341b785e89d40d1e35, type: 3}
  m_Name: Diary_Day7-2
  m_EditorClassIdentifier: Assembly-CSharp::DiaryData
  dayTitle: 
  pageContent: "A \xFAltima foi dona Ivone, trabalhadora dom\xE9stica. Cadastro limpo,
    perfil limpo, rota correta. S\xF3 faltava o implante, que n\xE3o cabia no or\xE7amento
    dela. Falou do grupo que esperava l\xE1 fora, e a \xFAnica pergunta que ficou
    foi onde ela ficaria. Qualquer que tenha sido meu gesto, a frase pronta estava
    l\xE1, e \xE9 a \xFAnica que realmente aprendi nesta semana.\r\n\r\nSegui o procedimento
    at\xE9 o fim e n\xE3o consigo dizer se isso tem alguma rela\xE7\xE3o com o que
    \xE9 justo. Talvez nunca tenha tido.\r\n\r\nAmanh\xE3 n\xE3o sei se volto \xE0
    cabine. O pior \xE9 que sei que voltarei."
