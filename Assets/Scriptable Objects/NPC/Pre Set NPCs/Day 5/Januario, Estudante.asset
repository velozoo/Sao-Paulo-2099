  job: Desempregado
  destinyStation: "Cap\xE3o Redondo"
  textAllied: "> RG e CARTEIRA DIGITAL. Janu\xE1rio Chuanfu, chino-bahiano, estudante
    com bolsa de estudos ativa. Nenhuma pend\xEAncia de documentos. Nenhum v\xEDnculo
    de filia\xE7\xE3o com o Sol Vermelho foi registrado. Cadastro regular. >"
  isAllied: 0
